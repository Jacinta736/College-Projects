mysql> CREATE TRIGGER update_balance_after_transaction
    -> AFTER INSERT ON transactions
    -> FOR EACH ROW
    -> BEGIN
    -> 
    ->     IF NEW.transactiontype = 'Deposit' THEN
    ->         UPDATE accounts
    ->         SET balance = balance + NEW.amount
    ->         WHERE accountid = NEW.toaccount;
    -> 
    ->     ELSEIF NEW.transactiontype = 'Withdraw' THEN
    ->         UPDATE accounts
    ->         SET balance = balance - NEW.amount
    ->         WHERE accountid = NEW.fromaccount;
    -> 
    ->     ELSEIF NEW.transactiontype = 'Transfer' THEN
    ->         UPDATE accounts
    ->         SET balance = balance - NEW.amount
    ->         WHERE accountid = NEW.fromaccount;
    -> 
    ->         UPDATE accounts
    ->         SET balance = balance + NEW.amount
    ->         WHERE accountid = NEW.toaccount;
    ->     END IF;
    -> 
    -> END //
